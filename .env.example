# discord-music — environment template
#
# Copy to `.env`, fill the placeholders, never commit `.env` (it is gitignored).
# Values below are examples, not real credentials.
#
# Everything written as `<...>` is a placeholder: if a value still contains
# angle brackets or looks like a sentence, it is not configured yet. Coolify
# configures env vars per service in its UI and does not read this file.

# Discord application / bot
# Where: https://discord.com/developers/applications → your application.
#   Bot → Reset Token reveals a new token once → DISCORD_TOKEN. Resetting drops
#     the previous token immediately, so update it and redeploy the bot together.
#   General Information → Application ID → DISCORD_CLIENT_ID.
#   Invite with OAuth2 → URL Generator, scopes `bot` + `applications.commands`
#     and permissions Connect + Speak; nothing else is required.
DISCORD_TOKEN=<paste-bot-token>
DISCORD_CLIENT_ID=<application-id>
# Optional. A guild id registers slash commands in that guild instantly instead
# of globally (global registration can take up to an hour). Enable Settings →
# Advanced → Developer Mode, then right-click the server → Copy Server ID.
DISCORD_GUILD_ID=<discord-server-id>
# Optional comma-separated allow-list. When set, commands and buttons from any
# other guild are ignored. Empty/unset = every guild the bot is in.
# Example shape: `<guild-id>,<guild-id>`; leave empty to serve every guild.
DISCORD_ALLOWED_GUILD_IDS=

# Bot HTTP control API
# Where: local policy, not a credential. Only BOT_CONTROL_SECRET is secret.
BOT_CONTROL_PORT=3001
# Bind address for the control API. Containers must use 0.0.0.0 so `music-web`
# can reach it over the Docker network; bare-metal runs should use 127.0.0.1.
BOT_CONTROL_HOST=0.0.0.0
# Required by both services. compose.dev.yml refuses to start without it.
# Generate once with `openssl rand -hex 32` (minimum 16 characters). The value
# must be byte-identical in `music-bot` and `music-web`; a mismatch is a 401 on
# every control call, not a boot error.
BOT_CONTROL_SECRET=<openssl rand -hex 32>
# How many guilds may stream audio at once (1..100). Size it by CPU/bandwidth.
MAX_CONCURRENT_STREAMS=3
# A voice session with nothing to play ends after this many seconds.
# 0 disables the timeout (0..86400).
IDLE_TIMEOUT_SECONDS=60
# One of debug | info | warn | error. `debug` is verbose; use it while testing.
LOG_LEVEL=info

# Audio storage (session-scoped)
# Where: your own infrastructure. `local` needs nothing; `s3` needs the block
# further down. Defaults suit dev — change only if you run Garage/MinIO.
# local = files under AUDIO_CACHE_DIR (dev default); s3 = Garage/MinIO.
AUDIO_STORE=local
# Inside the bot container. Mount a volume at /data (owned by uid 1000) so a
# session can write; the directory is wiped at boot.
AUDIO_CACHE_DIR=/data/audio
# Safety-net LRU cap for one very long session (bytes; 1.5 GiB).
# Range: at least 67108864 (64 MiB). Raise only for very long sessions.
AUDIO_CACHE_MAX_BYTES=1610612736
# Refuse individual downloads larger than this (bytes; 64 MiB).
AUDIO_CACHE_MAX_FILE_BYTES=67108864
# Prefetch the next queued track; playback streams normally when false.
PREFETCH_ENABLED=true
# 1..4. Keep it at or below MAX_CONCURRENT_STREAMS.
PREFETCH_MAX_CONCURRENT=2
# How many upcoming tracks to prefetch (1..3, default 2). Prefetch jobs use a
# separate budget: playback never waits for one.
PREFETCH_DEPTH=2
# How much decoded audio to buffer before a streamed track starts (ms,
# 100..2000, default 250). Lower values start faster but risk stalls on a slow
# network; if no bytes arrive within 4x this window the track falls back to
# piping instead of failing.
STREAM_PREBUFFER_MS=250

# Truncation guard. A stream that ends before its known duration is resumed
# instead of being treated as a finished track (the AudioPlayer reports both
# as Idle). Recovery order: the complete session cache, a freshly resolved URL
# at the resume offset, then the yt-dlp pipe; two attempts per track, then the
# queue advances. A complete stream ends at >=90% and is untouched.
# Where: tuning only — leave the defaults unless you are chasing truncation.
STREAM_TRUNCATION_GUARD=true
# Fraction of the duration that counts as "finished" (0.5..1, default 0.9).
STREAM_TRUNCATION_RATIO=0.9

# Streamed first play. The stream cannot be measured before it starts, so a
# one-pass loudnorm there dynamically ducks a hot master (a -8 LUFS / +2.6 dBTP
# track loses ~8 dB to reach the target; audible as "it goes quiet after ~10 s").
# limiter = peak limiting only, no gain change and no pumping (default).
# loudnorm / dynaudnorm = the old one-pass behaviour; off = no -af at all.
# Where: a listening preference; the default is the measured-safe choice.
AUDIO_STREAM_FILTER=limiter

# Cached fallback (applied when no measured gain exists yet, and to the stream
# when AUDIO_STREAM_FILTER selects a dynamic mode).
# loudnorm = one-pass EBU R128: targets integrated loudness. dynaudnorm is
# smoother but less exact per track. off removes the -af filter entirely.
AUDIO_NORMALIZE=loudnorm
# loudnorm only. Integrated loudness target (LUFS, -30..-5), true-peak ceiling
# (dBTP, -6..0), and loudness range target (1..20).
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK_DB=-1.0
AUDIO_LRA=11
# dynaudnorm only. Analysis window in milliseconds (10..500).
AUDIO_DYN_FRAME_MS=150
# Two-pass: a cached track is measured once and replayed with its exact gain
# (still capped by the true-peak ceiling). The streamed first play is limited,
# not normalised, so track 1 may be louder until a later play has a gain.
# Set false to skip analysis entirely.
AUDIO_TWO_PASS=true
# Symmetric bound on a measured gain, in dB (0..24).
AUDIO_MAX_GAIN_DB=12
# Note: /volume is applied after normalization, on the AudioResource, so it
# stays a live per-guild control and is never baked into the filter.
# Outgoing Opus bitrate (kbps, 16..128; default 96). The encoder itself cannot
# exceed 128 kbps, and Discord also caps the stream at the voice channel's own
# bitrate, so a 64 kbps channel still gets 64.
AUDIO_BITRATE_KBPS=96

# S3/Garage backend (required only when AUDIO_STORE=s3)
# Use the S3 API endpoint (port 3900), never the admin API (3903).
# Where: your Garage/MinIO instance. For the bundled Garage:
#   1. endpoint is `http://garage:3900` — the admin API on :3903 answers with
#      an unreadable error, it is not an S3 endpoint
#   2. `garage bucket create <bucket>`
#   3. `garage key create <name>` prints the key id and secret once → paste both
#   4. `garage bucket allow --read --write <bucket> --key <name>`
#   5. S3_FORCE_PATH_STYLE must stay true; Garage has no virtual-host buckets
S3_ENDPOINT=<http://garage:3900>
S3_REGION=garage
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<garage-access-key>
S3_SECRET_ACCESS_KEY=<garage-secret-key>
S3_FORCE_PATH_STYLE=true
# Key prefix inside the bucket; wiped at boot. Change it to isolate deployments
# that share one bucket.
S3_PREFIX=audio

# External media tooling
# Where: paths inside the bot container image. Bare-metal: use `which yt-dlp`,
# `which deno`, `which ffmpeg` instead.
YTDLP_PATH=/usr/local/bin/yt-dlp
DENO_PATH=/usr/local/bin/deno
FFMPEG_PATH=/usr/bin/ffmpeg
# Optional. A Netscape cookies.txt exported from a throwaway YouTube account
# (never your main one) fixes "Sign in to confirm you're not a bot". Put the
# file at this path inside the bot container (`/data` is the mounted volume) or
# point the variable elsewhere. It is only passed to yt-dlp when the file
# exists, so leaving this set without the file simply means "no cookies".
YTDLP_COOKIES_FILE=/data/cookies.txt
# Optional. Egress proxy for YouTube requests, e.g. a residential IP when the
# host is blocked. Shape: `<http://proxy-host:port>`.
YTDLP_PROXY=
# Optional. URL of a PO-token provider (bgutil) that solves the JS challenge;
# shape `<http://pot-provider:4416>`. Unset = no provider.
POT_PROVIDER_URL=
# Persists yt-dlp's player/JS-challenge cache across invocations (container-local).
# Scratch only: safe to delete at any time, never holds credentials.
YTDLP_CACHE_DIR=/tmp/yt-dlp-cache

# Resolver (query -> track). ytdlp is the default and the pre-P2 path: flipping
# this changes nothing until you set RESOLVER=innertube.
#   ytdlp     spawn yt-dlp for every resolve/stream (default, most compatible)
#   innertube a persistent youtubei.js client; playback uses the signed
#             googlevideo URL it returns and skips yt-dlp entirely
# Either way a resolver failure degrades to yt-dlp, so the command never fails.
# Where: no credentials in either mode. `ytdlp` is the safe default; `innertube`
# is faster but experimental (undocumented client, may break without notice).
RESOLVER=ytdlp
# Innertube client used for playback. VISIONOS is the only client measured to
# return URLs ffmpeg can stream (10/10 sampled videos); IOS manages 1/8, and
# ANDROID/WEB fail to decipher while TV reports the page as unplayable.
# VISIONOS is an undocumented client and YouTube may remove it at any time —
# which is exactly why RESOLVER stays opt-in.
#   VISIONOS | IOS | ANDROID | TV | WEB
INNERTUBE_CLIENT=VISIONOS
# Consecutive innertube failures before every call is routed to yt-dlp (1..100).
# i.e. after this many failures in a row the breaker opens and yt-dlp takes over.
RESOLVER_FAILURE_THRESHOLD=3
# How long the breaker stays open before one half-open probe (1000..86400000).
# One success closes it; a failure re-opens it for another cooldown.
RESOLVER_COOLDOWN_MS=600000

# Music link providers (/play with a Spotify or Apple Music link)
# Single tracks from either platform work with NO credentials: Spotify reads the
# public page's OpenGraph tags (then falls back to oEmbed), Apple Music reads its
# JSON-LD; the engine then searches YouTube for a match.
# Spotify ALBUMS and PLAYLISTS need Web API credentials (both or neither):
# create an app at https://developer.spotify.com/dashboard and copy its id and
# secret here. Without them, Spotify collections reply with a message asking for
# a track link instead.
# Note: since 2025 the dashboard only issues client credentials to accounts with
# an active Spotify Premium subscription. Apple Music needs nothing at all.
# Where: Dashboard → your app → Settings → Client ID / Client secret.
SPOTIFY_CLIENT_ID=<spotify-client-id>
SPOTIFY_CLIENT_SECRET=<spotify-client-secret>
# Cap on tracks expanded from one album/playlist link (1..100, default 50).
MUSIC_LINK_MAX_TRACKS=50

# Database
# Where: Postgres. Shape: `postgres://<user>:<password>@<host>:5432/<db>`.
# In Coolify use the database resource's *internal* URL (host is the container
# name, no published port); local Docker Compose already sets it for you.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>

# Web app
# Where: `music-web`. These are not secrets; they must match the deployment.
PORT=3000
# Production default. For Vite dev (browser origin) use http://localhost:5173;
# for Docker Compose use http://localhost:3000.
# Must equal the browser's origin exactly (scheme, host, port, no path) — it is
# the CSRF check, not just a link for emails.
PUBLIC_BASE_URL=https://music.dasa122.net
# How `music-web` reaches the bot's control API: compose `http://music-bot:3001`,
# Coolify the bot service's internal name/port. Not a public URL.
BOT_INTERNAL_URL=http://music-bot:3001

# Authentik OIDC
# Where: Authentik admin → Applications → Providers → your OIDC provider.
# Issuer shape: `https://<authentik-host>/application/o/<application-slug>/`
# (trailing slash included; copy it from the provider page, do not retype).
AUTHENTIK_ISSUER=<https://authentik-host/application/o/music/>
# Client ID/secret of a *confidential* provider with scopes
# `openid profile email`. Both values are shown once on creation.
AUTHENTIK_CLIENT_ID=<authentik-client-id>
AUTHENTIK_CLIENT_SECRET=<authentik-client-secret>
# For Vite dev this must match the API callback: http://localhost:3000/api/auth/callback
# (Docker Compose: http://localhost:3000/api/auth/callback).
# Must be byte-identical to the provider's redirect URI, e.g.
# https://music.dasa122.net/api/auth/callback — a trailing slash or http vs
# https is a redirect_uri mismatch, not a login failure you can debug later.
AUTHENTIK_REDIRECT_URI=https://music.dasa122.net/api/auth/callback
# Group that grants admin in the web UI. It must exist in Authentik and contain
# your user; a misspelt name silently yields a non-admin login.
AUTHENTIK_ADMIN_GROUP=music-admins

# Sessions
# How long a login lasts (1..365; the schema default is 1 day). The value below
# is an example, not a default.
SESSION_TTL_DAYS=7
# Must stay true in production (the app refuses to boot with false when
# NODE_ENV=production). Set false only for plain-http local dev, otherwise the
# browser drops the cookie and login loops.
SESSION_COOKIE_SECURE=true
# Dev-only: `true` skips Authentik and logs everyone in as an admin. Refused
# when NODE_ENV=production; leave empty everywhere else.
AUTH_DEV_BYPASS=
