# Discord application / bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional comma-separated allow-list. When set, commands and buttons from any
# other guild are ignored. Empty/unset = every guild the bot is in.
DISCORD_ALLOWED_GUILD_IDS=

# Bot HTTP control API
BOT_CONTROL_PORT=3001
# Bind address for the control API. Containers must use 0.0.0.0 so `music-web`
# can reach it over the Docker network; bare-metal runs should use 127.0.0.1.
BOT_CONTROL_HOST=0.0.0.0
# Required by both services. compose.dev.yml refuses to start without it.
BOT_CONTROL_SECRET=
MAX_CONCURRENT_STREAMS=3
# A voice session with nothing to play ends after this many seconds.
IDLE_TIMEOUT_SECONDS=60
LOG_LEVEL=info

# Audio storage (session-scoped)
# local = files under AUDIO_CACHE_DIR (dev default); s3 = Garage/MinIO.
AUDIO_STORE=local
AUDIO_CACHE_DIR=/data/audio
# Safety-net LRU cap for one very long session (bytes; 1.5 GiB).
AUDIO_CACHE_MAX_BYTES=1610612736
# Refuse individual downloads larger than this (bytes; 64 MiB).
AUDIO_CACHE_MAX_FILE_BYTES=67108864
# Prefetch the next queued track; playback streams normally when false.
PREFETCH_ENABLED=true
PREFETCH_MAX_CONCURRENT=2
# How many upcoming tracks to prefetch (1..3, default 2). Prefetch jobs use a
# separate budget: playback never waits for one.
PREFETCH_DEPTH=2
# How much decoded audio to buffer before a streamed track starts (ms,
# 100..2000, default 250). Lower values start faster but risk stalls on a slow
# network; if no bytes arrive within 4x this window the track falls back to
# piping instead of failing.
STREAM_PREBUFFER_MS=250

# Streamed first play. The stream cannot be measured before it starts, so a
# one-pass loudnorm there dynamically ducks a hot master (a -8 LUFS / +2.6 dBTP
# track loses ~8 dB to reach the target; audible as "it goes quiet after ~10 s").
# limiter = peak limiting only, no gain change and no pumping (default).
# loudnorm / dynaudnorm = the old one-pass behaviour; off = no -af at all.
AUDIO_STREAM_FILTER=limiter

# Cached fallback (applied when no measured gain exists yet, and to the stream
# when AUDIO_STREAM_FILTER selects a dynamic mode).
# loudnorm = one-pass EBU R128: targets integrated loudness. dynaudnorm is
# smoother but less exact per track. off removes the -af filter entirely.
AUDIO_NORMALIZE=loudnorm
# loudnorm only. Integrated loudness target (LUFS, -30..-5), true-peak ceiling
# (dBTP, -6..0), and loudness range target (1..20).
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK_DB=-1.0
AUDIO_LRA=11
# dynaudnorm only. Analysis window in milliseconds (10..500).
AUDIO_DYN_FRAME_MS=150
# Two-pass: a cached track is measured once and replayed with its exact gain
# (still capped by the true-peak ceiling). The streamed first play is limited,
# not normalised, so track 1 may be louder until a later play has a gain.
# Set false to skip analysis entirely.
AUDIO_TWO_PASS=true
# Symmetric bound on a measured gain, in dB (0..24).
AUDIO_MAX_GAIN_DB=12
# Note: /volume is applied after normalization, on the AudioResource, so it
# stays a live per-guild control and is never baked into the filter.
# Outgoing Opus bitrate (kbps, 16..128; default 96). The encoder itself cannot
# exceed 128 kbps, and Discord also caps the stream at the voice channel's own
# bitrate, so a 64 kbps channel still gets 64.
AUDIO_BITRATE_KBPS=96

# S3/Garage backend (required only when AUDIO_STORE=s3)
# Use the S3 API endpoint (port 3900), never the admin API (3903).
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=audio

# External media tooling
YTDLP_PATH=/usr/local/bin/yt-dlp
DENO_PATH=/usr/local/bin/deno
FFMPEG_PATH=/usr/bin/ffmpeg
YTDLP_COOKIES_FILE=/data/cookies.txt
YTDLP_PROXY=
POT_PROVIDER_URL=
# Persists yt-dlp's player/JS-challenge cache across invocations (container-local).
YTDLP_CACHE_DIR=/tmp/yt-dlp-cache

# Resolver (query -> track). ytdlp is the default and the pre-P2 path: flipping
# this changes nothing until you set RESOLVER=innertube.
#   ytdlp     spawn yt-dlp for every resolve/stream (default, most compatible)
#   innertube a persistent youtubei.js client; playback uses the signed
#             googlevideo URL it returns and skips yt-dlp entirely
# Either way a resolver failure degrades to yt-dlp, so the command never fails.
RESOLVER=ytdlp
# Innertube client used for playback. VISIONOS is the only client measured to
# return URLs ffmpeg can stream (10/10 sampled videos); IOS manages 1/8, and
# ANDROID/WEB fail to decipher while TV reports the page as unplayable.
# VISIONOS is an undocumented client and YouTube may remove it at any time —
# which is exactly why RESOLVER stays opt-in.
#   VISIONOS | IOS | ANDROID | TV | WEB
INNERTUBE_CLIENT=VISIONOS
# Consecutive innertube failures before every call is routed to yt-dlp (1..100).
RESOLVER_FAILURE_THRESHOLD=3
# How long the breaker stays open before one half-open probe (1000..86400000).
RESOLVER_COOLDOWN_MS=600000

# Music link providers (/play with a Spotify or Apple Music link)
# song.link (Odesli) maps a track to a YouTube video with NO auth required, so
# single tracks from either platform work out of the box.
# Spotify ALBUMS and PLAYLISTS need Web API credentials (both or neither):
# create an app at https://developer.spotify.com/dashboard and copy its id and
# secret here. Without them, Spotify collections reply with a "set
# SPOTIFY_CLIENT_ID/SPOTIFY_CLIENT_SECRET" message; tracks still work via Odesli.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Cap on tracks expanded from one album/playlist link (1..100, default 50).
MUSIC_LINK_MAX_TRACKS=50

# Database
DATABASE_URL=

# Web app
PORT=3000
# Production default. For Vite dev (browser origin) use http://localhost:5173;
# for Docker Compose use http://localhost:3000.
PUBLIC_BASE_URL=https://music.dasa122.net
BOT_INTERNAL_URL=http://music-bot:3001

# Authentik OIDC
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# For Vite dev this must match the API callback: http://localhost:3000/api/auth/callback
# (Docker Compose: http://localhost:3000/api/auth/callback).
AUTHENTIK_REDIRECT_URI=
AUTHENTIK_ADMIN_GROUP=music-admins

# Sessions
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=true
AUTH_DEV_BYPASS=
