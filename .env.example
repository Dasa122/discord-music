# Discord application / bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional comma-separated allow-list. When set, commands and buttons from any
# other guild are ignored. Empty/unset = every guild the bot is in.
DISCORD_ALLOWED_GUILD_IDS=

# Bot HTTP control API
BOT_CONTROL_PORT=3001
# Bind address for the control API. Containers must use 0.0.0.0 so `music-web`
# can reach it over the Docker network; bare-metal runs should use 127.0.0.1.
BOT_CONTROL_HOST=0.0.0.0
# Required by both services. compose.dev.yml refuses to start without it.
BOT_CONTROL_SECRET=
MAX_CONCURRENT_STREAMS=3
IDLE_TIMEOUT_SECONDS=300
LOG_LEVEL=info

# External media tooling
YTDLP_PATH=/usr/local/bin/yt-dlp
DENO_PATH=/usr/local/bin/deno
FFMPEG_PATH=/usr/bin/ffmpeg
YTDLP_COOKIES_FILE=/data/cookies.txt
YTDLP_PROXY=
POT_PROVIDER_URL=

# Database
DATABASE_URL=

# Web app
PORT=3000
# Production default. For Vite dev (browser origin) use http://localhost:5173;
# for Docker Compose use http://localhost:3000.
PUBLIC_BASE_URL=https://music.dasa122.net
BOT_INTERNAL_URL=http://music-bot:3001

# Authentik OIDC
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# For Vite dev this must match the API callback: http://localhost:3000/api/auth/callback
# (Docker Compose: http://localhost:3000/api/auth/callback).
AUTHENTIK_REDIRECT_URI=
AUTHENTIK_ADMIN_GROUP=music-admins

# Sessions
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=true
AUTH_DEV_BYPASS=
